+def read_pk_plan():
+    """Return the tt-pk-compiler plan if RESIDENT_PK_PLAN points at a JSON file.
+
+    Used by model.py to swap hardcoded worker rectangles for a compiler-driven
+    placement. Any field not in the plan falls through to Resident's own logic.
+    """
+    path = os.environ.get("RESIDENT_PK_PLAN")
+    if not path:
+        return None
+    with open(path) as f:
+        return json.load(f)
